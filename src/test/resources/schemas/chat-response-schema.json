{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatBot API Response Schema",
  "description": "Expected JSON schema for the /chat endpoint response",
  "type": "object",
  "required": ["response", "sessionId", "timestamp", "status"],
  "properties": {
    "response": {
      "type": "string",
      "description": "The chatbot's reply text",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "description": "Session identifier echoed back from the request",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of the response"
    },
    "status": {
      "type": "string",
      "description": "Response status",
      "enum": ["success", "error", "partial"]
    },
    "confidence": {
      "type": "number",
      "description": "Confidence score between 0 and 1",
      "minimum": 0,
      "maximum": 1
    },
    "intent": {
      "type": "string",
      "description": "Detected user intent (optional)"
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata block",
      "properties": {
        "responseTimeMs": { "type": "number" },
        "modelVersion":   { "type": "string" },
        "tokensUsed":     { "type": "integer" }
      }
    }
  },
  "additionalProperties": true
}
